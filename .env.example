ANTHROPIC_API_KEY=sk-ant-...
# Mật khẩu bảo vệ app khi deploy public. Bỏ trống = ai cũng dùng được.
APP_PASSWORD=
# YouTube Data API v3 key (tùy chọn nhưng NÊN có khi deploy Vercel):
# lấy metadata + comment + mô tả video ổn định từ IP máy chủ. Cách tạo: xem DEPLOY.md.
YOUTUBE_API_KEY=
# Google AI Studio key (tùy chọn nhưng NÊN có khi deploy Vercel):
# khi YouTube chặn mọi đường lấy phụ đề, app đưa link video cho Gemini nghe lại.
# Lấy key: https://aistudio.google.com/apikey — bản free 8 giờ video/ngày, chỉ video công khai.
GEMINI_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-3.6-flash
# PORT=3000
